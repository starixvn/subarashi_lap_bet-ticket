@{
    Layout = null;
    var langCode = System.Globalization.CultureInfo.CurrentCulture.Name;
    var rootUrl = Url.Content("~");
    var title = ViewResources.DetailedBetlist + " - " + ViewData["Title"];
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=0">
    <title>@title</title>
    <meta name="description" content="LAP" />
    <base href="@rootUrl" />
    <environment include="Development">
        <link href="~/css/dev/main.css" asp-append-version="true" rel="stylesheet" type="text/css" />
    </environment>
    <environment exclude="Development">
        <link href="~/css/pro/main.css" asp-append-version="true" rel="stylesheet" type="text/css" />
    </environment>
    @RenderSection("pagecss", required: false)
</head>
<body>
    <div class="wrapper">
        @RenderBody()
    </div>
    <script type="text/javascript">
        var PageLanguage = "@langCode";
        window.rootUrl = '@rootUrl';
        @RenderSection("globaljscode", required: false)
    </script>

    <environment include="Development">
        <script src="~/js/dev/lib/vendor.chunk.js" asp-append-version="true"></script>
    </environment>
    <environment exclude="Development">
        <script src="~/js/pro/lib/vendor.chunk.js" asp-append-version="true"></script>
    </environment>
    @await RenderSectionAsync("pagejs", required: false)
</body>
</html>
