@using Microsoft.Extensions.Configuration;
@inject IConfiguration configuration
@{
    Layout = null;
    var langCode = System.Globalization.CultureInfo.CurrentUICulture.Name;
    var rootUrl = Url.Content("~");
    var title = ViewResources.DetailedBetlist + " - " + ViewData["Title"];
    _ = bool.TryParse(configuration["IsProduction"], out bool isProduction);
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=0">
    <title>@title</title>
    <meta name="description" content="LAP" />
    <base href="@rootUrl" />
    <link href="~/css/main.css" asp-append-version="true" rel="stylesheet" type="text/css" />
    @RenderSection("pagecss", required: false)
</head>
<body>
    <div class="wrapper">
        @RenderBody()
    </div>
    <script type="text/javascript">
        var PageLanguage = "@langCode";
        window.rootUrl = '@rootUrl';
        @RenderSection("globaljscode", required: false)
    </script>
    <script src="~/js/lib/vendor.chunk.js" asp-append-version="true"></script>
    @await RenderSectionAsync("pagejs", required: false)
    @if (isProduction)
    {
        <!-- Google Analytics -->
        <script async src="https://www.googletagmanager.com/gtag/js?id=G-M09N5LNEH1"></script>
        <script>
            window.dataLayer = window.dataLayer || [];
            function gtag() { dataLayer.push(arguments); }
            gtag('js', new Date());

            gtag('config', 'G-M09N5LNEH1'{
                cookieFlags: 'secure;samesite=none'
            });
            gtag('config', 'UA-93927620-1',{
                cookieFlags: 'secure;samesite=none'
            });

        </script>
        <!-- End Google Analytics -->
    }
</body>
</html>
