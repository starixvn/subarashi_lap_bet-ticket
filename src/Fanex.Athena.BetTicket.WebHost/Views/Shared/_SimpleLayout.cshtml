@{
    Layout = null;
    var rootUrl = Url.Content("~");
    var title = ViewResources.BetTicket + " - " + ViewData["Title"];
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=0">
    <title>@title</title>
    <meta name="description" content="Bet Ticket Result" />
    <base href="@rootUrl" />
    <link href="~/css/simple-main.css" asp-append-version="true" rel="stylesheet" type="text/css" />
    @RenderSection("pagecss", required: false)
</head>
<body>
    <div class="wrapper">
        @RenderBody()
    </div>
</body>
</html>
