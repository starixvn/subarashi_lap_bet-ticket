@{
    Layout = null;
}
@model int
@{
    var code = Model;
    string errorMsg;
    switch (code)
    {
        case 400:
            errorMsg = ViewResources.InvalidRequestMsg;
            break;

        case 401:
            errorMsg = ViewResources.TokenWasExpired;
            break;

        case 403:
            errorMsg = ViewResources.HttpError_403;
            break;

        case 404:
            errorMsg = ViewResources.HttpError_404;
            break;

        default:
            errorMsg = ViewResources.HttpError_Default;
            break;
    }
}
<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=0">
    <title>Error!!!!!</title>

    <style type="text/css">
        body {
            background: #fff;
        }

        .error-content {
            padding-top: 40px;
        }

        img {
            margin: 10px auto;
            display: block;
        }

        p {
            text-align: center;
            font-size: 18px;
            line-height: 20px;
        }

        .first-line {
            color: #0b3d6b;
            font-size: 45px;
        }

        .second-line {
            color: #545454;
        }

        .btn {
            display: inline-block;
            padding: 6px 12px;
            border-radius: 3px;
            font-size: 18px;
            text-decoration: none;
        }

        .btn-submit {
            background-color: #1C80F0;
            color: #fff;
        }
    </style>
</head>
<body>
    <div class="error-content">
        <img src="~/images/robot.jpg" />
        <p class="first-line">Oops...</p>
        <p class="second-line">@errorMsg</p>
    </div>
</body>
</html>
