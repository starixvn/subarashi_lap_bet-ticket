@{
    Layout = "_SimpleLayout";
    ViewData["Title"] = ViewResources.CashOutHistory;
}

@using System.Globalization
@model NewCashOutBetListDetailViewModel

@{
}

@section pagecss {
    <link href="~/css/betlist-detail-cashout.css" rel="stylesheet" type="text/css" asp-append-version="true" />
}

<div class="page-results betlist-container">
    <div class="table-content">
        <div class="content-title">
            @ViewResources.RefNo: @Html.Raw(Model.TransId) - <span class="base-currency">
                @(string.IsNullOrEmpty(Model.BaseCurrency) ? string.Format(ViewResources.ViewIn, Model.Currency) : string.Format(ViewResources.ViewIn, Model.BaseCurrency.ToUpper(CultureInfo.InvariantCulture)))
            </span>
        </div>

        <table class="table">
            <thead>
                <tr>
                    <th class="col-transtime">@ViewResources.DateTime</th>
                    <th class="col-transtime">@ViewResources.CashOutAmount</th>
                    <th class="">@ViewResources.Activity</th>
                </tr>
            </thead>
            @if (Model == null || !Model.DetailHistory.Any())
            {
                <tbody>
                    <tr>
                        <td colspan="3" class="text-center">@ViewResources.NetworkLatency</td>
                    </tr>
                </tbody>
            }
            else
            {
                foreach (var item in Model.DetailHistory)
                {
                    <tr>
                        <td class="right-align">
                            @Html.Raw(item.ChangeTimeText)
                        </td>
                        <td class="right-align">
                            @Html.Raw(item.CashoutAmountText)
                        </td>
                        <td>
                            <div class="text-left">@Html.Raw(item.ActionName)</div>
                        </td>
                    </tr>
                }
            }
        </table>
    </div>
</div>