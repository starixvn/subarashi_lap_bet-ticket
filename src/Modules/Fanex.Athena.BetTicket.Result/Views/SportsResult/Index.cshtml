@{
    Layout = "_SimpleLayout";
    ViewData["Title"] = ViewResources.Result;
}
@section pagecss {
    <environment include="Development">
        <link href="~/css/dev/result.css" asp-append-version="true" rel="stylesheet" type="text/css" />
    </environment>
    <environment exclude="Development">
        <link href="~/css/pro/result.css" asp-append-version="true" rel="stylesheet" type="text/css" />
    </environment>
}

<div class="result-container">
    @Html.Raw(ViewBag.Data)
</div>
